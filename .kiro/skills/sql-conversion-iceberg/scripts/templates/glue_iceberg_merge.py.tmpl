WATERMARK_COLUMN = __WATERMARK_COLUMN__    # column ordering duplicate source rows (latest wins), or None

args = getResolvedOptions(sys.argv, ["JOB_NAME", "catalog_warehouse"] + (["run_id"] if "--run_id" in sys.argv else []))
