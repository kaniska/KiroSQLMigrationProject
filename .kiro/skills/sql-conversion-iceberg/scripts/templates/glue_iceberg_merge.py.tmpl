MERGE INTO {TARGET_TABLE} t
USING src s
ON {on_clause}
WHEN MATCHED THEN UPDATE SET {set_clause}
WHEN NOT MATCHED THEN INSERT ({', '.join(ins_cols)}) VALUES ({', '.join('s.' + c for c in ins_cols)})
""")
