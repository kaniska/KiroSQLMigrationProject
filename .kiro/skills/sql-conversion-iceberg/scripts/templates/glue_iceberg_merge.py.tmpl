SOURCE_TABLE = "__SOURCE_TABLE__"          # catalog.db.table or a temporary view created below
TARGET_TABLE = "__TARGET_TABLE__"
MERGE_KEYS = __MERGE_KEYS__                # list of key columns; the source must be unique on them
