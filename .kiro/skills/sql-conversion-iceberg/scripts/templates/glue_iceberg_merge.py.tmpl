         .config("spark.sql.catalog." + CATALOG + ".catalog-impl", "org.apache.iceberg.aws.glue.GlueCatalog")
         .config("spark.sql.catalog." + CATALOG + ".io-impl", "org.apache.iceberg.aws.s3.S3FileIO")
         .config("spark.sql.catalog." + CATALOG + ".warehouse", args["catalog_warehouse"])
