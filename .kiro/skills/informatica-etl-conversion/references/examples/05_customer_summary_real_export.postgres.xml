    <MAPPING DESCRIPTION ="Customer order summary – full SQL Server job in the Source Qualifier, lookup, update override and session Pre/Post SQL" ISVALID ="YES" NAME ="m_Load_Customer_Summary" OBJECTVERSION ="1" VERSIONNUMBER ="1">
