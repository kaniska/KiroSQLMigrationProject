{
  "_comment": "Map for 'infa_sql_tool.py inject --map' when the target is Iceberg on S3 (IC-46): PowerCenter does not write Iceberg tables. Sources and lookups are read through Athena (ODBC, read-only); targets become S3 file targets (PowerExchange for Amazon S3, Parquet landing prefix) and the Glue MERGE job generated by sql-conversion-iceberg loads the Iceberg table. Datatypes follow the Iceberg spec (all character types → string).",
  "database_type": "ODBC",
  "owner": "sales_lake",
  "target_load_type": "Normal",
  "load_path": {
    "landing": "s3://example-lake-bucket/landing/<mapping>/",
    "loader": ".kiro/skills/sql-conversion-iceberg/scripts/iceberg_tool.py job",
    "reads": "Athena ODBC (read-only)",
    "writes": "PowerExchange for Amazon S3 (Parquet)"
  },
