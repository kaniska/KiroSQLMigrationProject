$$BATCH_SIZE=100
$$LOAD_ID=42
$DBConnection_Src=CONN_SALESDB_SRC_PG
$DBConnection_Tgt=CONN_SALESDW_TGT_PG
[SALES_DW.WF:wf_Load_Fact_Shipping.ST:s_m_Load_Fact_Shipping]
