            <TABLEATTRIBUTE NAME ="Sql Query" VALUE ="-- Kundenübersicht / résumé client: one row per customer with orders up to $$AS_OF_DATE&#xD;&#xA;WITH ranked AS (&#xD;&#xA;    SELECT o.CustomerId, o.OrderId, o.CreatedAt, o.TotalAmount,&#xD;&#xA;           ROW_NUMBER() OVER (PARTITION BY o.CustomerId ORDER BY o.CreatedAt DESC, o.OrderId DESC) AS rn&#xD;&#xA;    FROM dbo.Orders o WITH (NOLOCK)&#xD;&#xA;    WHERE o.[Status] &lt;&gt; N&apos;Cancelled&apos;&#xD;&#xA;      AND o.CreatedAt &lt; DATEADD(DAY, 1, CONVERT(DATE, &apos;$$AS_OF_DATE&apos;, 112))&#xD;&#xA;), totals AS (&#xD;&#xA;    SELECT r.CustomerId,&#xD;&#xA;           COUNT(*) AS OrderCount,&#xD;&#xA;           CAST(SUM(r.TotalAmount) AS DECIMAL(19,4)) AS LifetimeAmount,&#xD;&#xA;           MAX(CASE WHEN r.rn = 1 THEN r.TotalAmount END) AS LastOrderAmount,&#xD;&#xA;           MAX(r.CreatedAt) AS LastOrderAt&#xD;&#xA;    FROM ranked r&#xD;&#xA;    GROUP BY r.CustomerId&#xD;&#xA;)&#xD;&#xA;SELECT c.CustomerId,&#xD;&#xA;       LTRIM(RTRIM(c.FirstName)) + N&apos; &apos; + ISNULL(c.LastName, N&apos;&apos;) AS CustomerName,&#xD;&#xA;       t.OrderCount,&#xD;&#xA;       t.LifetimeAmount,&#xD;&#xA;       t.LastOrderAmount,&#xD;&#xA;       DATEDIFF(DAY, t.LastOrderAt, CONVERT(DATE, &apos;$$AS_OF_DATE&apos;, 112)) AS DaysSinceLastOrder,&#xD;&#xA;       ISNULL(sk.Skus, &apos;&apos;) AS PurchasedSkus&#xD;&#xA;FROM totals t&#xD;&#xA;JOIN dbo.Customers c WITH (NOLOCK) ON c.CustomerId = t.CustomerId&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT STRING_AGG(d.SKU, &apos;,&apos;) WITHIN GROUP (ORDER BY d.SKU) AS Skus&#xD;&#xA;    FROM (SELECT DISTINCT p.SKU&#xD;&#xA;          FROM dbo.OrderLines ol WITH (NOLOCK)&#xD;&#xA;          JOIN dbo.Orders o2 WITH (NOLOCK) ON o2.OrderId = ol.OrderId&#xD;&#xA;          JOIN dbo.Products p WITH (NOLOCK) ON p.ProductId = ol.ProductId&#xD;&#xA;          WHERE o2.CustomerId = c.CustomerId&#xD;&#xA;            AND o2.[Status] &lt;&gt; N&apos;Cancelled&apos;&#xD;&#xA;            AND o2.CreatedAt &lt; DATEADD(DAY, 1, CONVERT(DATE, &apos;$$AS_OF_DATE&apos;, 112))) d&#xD;&#xA;) sk&#xD;&#xA;ORDER BY c.CustomerId"/>
