        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]skills[\\\\/]sql-conversion-iceberg[\\\\/]scripts[\\\\/]iceberg_tool\\.py (ddl|check|ledger|job|run|package) .*",
        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]skills[\\\\/]schema-conformance[\\\\/]scripts[\\\\/]schema_tool\\.py (snapshot|compare|conform|refs|package) .*",
        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]skills[\\\\/]schema-change-propagation[\\\\/]scripts[\\\\/]change_tool\\.py (ingest|validate|plan|patch|scan|package) .*",
        "(python|py -3|python3)( -X utf8)? supporting-files[\\\\/]make_skill_runners\\.py( --check)?",
        "(python|py -3|python3)( -X utf8)? supporting-files[\\\\/]make_windows_agent\\.py( --check)?"
      ],
      "autoAllowReadonly": true
    },
    "fs_write": {
