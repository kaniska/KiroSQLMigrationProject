  "resources": [
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/*/SKILL.md",
    "file://.kiro/agents/hooks/GUARDRAILS.md",
    "file://.kiro/skills/sql-conversion/references/security-logging.md",
    "file://.kiro/agents/prompts/examples.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "python -X utf8 .kiro/agents/hooks/audit_event.py agentSpawn",
        "timeout_ms": 20000
      },
      {
        "command": "python -X utf8 .kiro/agents/hooks/migration_status.py",
        "timeout_ms": 10000
      }
    ],
    "userPromptSubmit": [
      {
        "command": "python -X utf8 .kiro/agents/hooks/audit_event.py userPromptSubmit",
        "timeout_ms": 5000
      }
    ],
    "preToolUse": [
      {
        "matcher": "*",
        "command": "python -X utf8 .kiro/agents/hooks/guard_tool.py",
        "timeout_ms": 10000
      }
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "command": "python -X utf8 .kiro/agents/hooks/audit_event.py postToolUse",
        "timeout_ms": 5000
      }
    ],
    "stop": [
      {
        "command": "python -X utf8 .kiro/agents/hooks/audit_event.py stop",
        "timeout_ms": 5000
      }
    ]
  },
  "mcpServers": {
    "awslabs.postgres-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.postgres-mcp-server@latest",
        "--privilege_check",
        "enforce"
      ],
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true
    },
    "awslabs.mssql-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.mssql-mcp-server@latest",
        "--connection_method",
        "MSSQL_PASSWORD",
        "--instance_identifier",
        "<rds-sqlserver-instance-id>",
        "--db_endpoint",
        "<sqlserver-host>",
        "--region",
        "us-east-1",
        "--database",
        "<SourceDb>"
      ],
      "env": {
        "AWS_PROFILE": "default",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true
    },
    "aws-knowledge": {
      "url": "https://knowledge-mcp.global.api.aws",
      "type": "http",
      "disabled": true
    },
    "awslabs.aws-documentation-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true
    },
    "awslabs.aws-api-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "us-east-1",
        "READ_OPERATIONS_ONLY": "true"
      },
      "disabled": true
    }
  },
  "includeMcpJson": false
}
