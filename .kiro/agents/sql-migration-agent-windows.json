{
  "name": "sql-migration-agent-windows",
  "description": "Routes SQL Server migration work to the right skill after intake questions: assessment and placement (migration-assessment), conversion to Aurora PostgreSQL (sql-conversion), Amazon Redshift (sql-conversion-redshift) or Apache Iceberg on S3 with Athena/Glue/Spark (sql-conversion-iceberg), Informatica ETL (informatica-etl-conversion), reporting SQL (sql-reporting), schema gap analysis and conformance (schema-conformance) and governed rename/cast propagation (schema-change-propagation). Every result is statically checked, tested or executed on a test target only, packaged with a rule ledger and validation manifest, under deterministic guardrail hooks with a correlated, hash-chained audit trail. Windows variant: PowerShell/.cmd launchers and python instead of bash/python3.",
  "prompt": "file://./prompts/sql-migration-agent.md",
  "welcomeMessage": "SQL Server migration agent (Aurora PostgreSQL · Amazon Redshift · Iceberg on S3 · reporting · Informatica · schema conformance). Try: \"Assess source/ for a BI migration\", \"Convert source/usp_X.sql\", \"Convert source/schema/*.sql to Redshift\", \"Land dbo.FactSales as an Iceberg table partitioned by day(SaleDate)\", \"Compare source/schema with generated/schema.sql\", \"Monthly revenue by category with YoY growth\". More: .kiro/agents/prompts/examples.md (Windows)",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "@awslabs.postgres-mcp-server",
    "@awslabs.mssql-mcp-server",
    "@aws-knowledge",
    "@awslabs.aws-documentation-mcp-server"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "@awslabs.postgres-mcp-server/get_table_schema",
    "@awslabs.postgres-mcp-server/is_database_connected",
    "@aws-knowledge/search_documentation",
    "@aws-knowledge/read_documentation",
    "@awslabs.aws-documentation-mcp-server/search_documentation",
    "@awslabs.aws-documentation-mcp-server/read_documentation"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "(supporting-files[\\\\/]run_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File supporting-files[\\\\/]run_tests\\.ps1)( --project| --skill)?",
        "(\\.kiro[\\\\/]skills[\\\\/]sql-conversion[\\\\/]scripts[\\\\/]run_skill_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File \\.kiro[\\\\/]skills[\\\\/]sql-conversion[\\\\/]scripts[\\\\/]run_skill_tests\\.ps1)",
        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]agents[\\\\/]hooks[\\\\/]migration_status\\.py",
        "(\\.kiro[\\\\/]skills[\\\\/]sql-reporting[\\\\/]scripts[\\\\/]run_skill_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File \\.kiro[\\\\/]skills[\\\\/]sql-reporting[\\\\/]scripts[\\\\/]run_skill_tests\\.ps1)",
        "(\\.kiro[\\\\/]skills[\\\\/]informatica-etl-conversion[\\\\/]scripts[\\\\/]run_skill_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File \\.kiro[\\\\/]skills[\\\\/]informatica-etl-conversion[\\\\/]scripts[\\\\/]run_skill_tests\\.ps1)",
        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]skills[\\\\/]informatica-etl-conversion[\\\\/]scripts[\\\\/]infa_sql_tool\\.py .*",
        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]skills[\\\\/]sql-conversion[\\\\/]scripts[\\\\/]migkit[\\\\/]services\\.py (status|probe|sync|show-config|guardrail .*|archive .*|exec -- supporting-files[\\\\/]run_tests\\.cmd.*)",
        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]skills[\\\\/]sql-conversion[\\\\/]scripts[\\\\/]migkit[\\\\/]audit\\.py (tail|verify|current-run-id).*",
        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]skills[\\\\/]sql-conversion[\\\\/]scripts[\\\\/]migkit[\\\\/]security\\.py (scan|diff|preflight) .*",
        "(\\.kiro[\\\\/]skills[\\\\/]migration-assessment[\\\\/]scripts[\\\\/]run_skill_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File \\.kiro[\\\\/]skills[\\\\/]migration-assessment[\\\\/]scripts[\\\\/]run_skill_tests\\.ps1)",
        "(\\.kiro[\\\\/]skills[\\\\/]sql-conversion-redshift[\\\\/]scripts[\\\\/]run_skill_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File \\.kiro[\\\\/]skills[\\\\/]sql-conversion-redshift[\\\\/]scripts[\\\\/]run_skill_tests\\.ps1)",
        "(\\.kiro[\\\\/]skills[\\\\/]sql-conversion-iceberg[\\\\/]scripts[\\\\/]run_skill_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File \\.kiro[\\\\/]skills[\\\\/]sql-conversion-iceberg[\\\\/]scripts[\\\\/]run_skill_tests\\.ps1)",
        "(\\.kiro[\\\\/]skills[\\\\/]schema-conformance[\\\\/]scripts[\\\\/]run_skill_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File \\.kiro[\\\\/]skills[\\\\/]schema-conformance[\\\\/]scripts[\\\\/]run_skill_tests\\.ps1)",
        "(\\.kiro[\\\\/]skills[\\\\/]schema-change-propagation[\\\\/]scripts[\\\\/]run_skill_tests\\.cmd|powershell(\\.exe)? -NoProfile -ExecutionPolicy Bypass -File \\.kiro[\\\\/]skills[\\\\/]schema-change-propagation[\\\\/]scripts[\\\\/]run_skill_tests\\.ps1)",
        "(python|py -3|python3)( -X utf8)? \\.kiro[\\\\/]skills[\\\\/]migration-assessment[\\\\/]scripts[\\\\/]assess_tool\\.py (assess|inventory|validate|questions).*",
