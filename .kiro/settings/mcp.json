{
  "mcpServers": {
    "awslabs.postgres-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.postgres-mcp-server@latest",
        "--privilege_check",
        "enforce"
      ],
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": [
        "get_table_schema",
        "is_database_connected"
      ]
    },
    "awslabs.mssql-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.mssql-mcp-server@latest",
        "--connection_method",
        "MSSQL_PASSWORD",
        "--instance_identifier",
        "<rds-sqlserver-instance-id>",
        "--db_endpoint",
        "<sqlserver-host>",
        "--region",
        "us-east-1",
        "--database",
        "<SourceDb>"
      ],
      "env": {
        "AWS_PROFILE": "default",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": []
    },
    "aws-knowledge": {
      "url": "https://knowledge-mcp.global.api.aws",
      "type": "http",
      "disabled": true,
      "autoApprove": [
        "search_documentation",
        "read_documentation"
      ]
    },
    "awslabs.aws-documentation-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": [
        "search_documentation",
        "read_documentation"
      ]
    },
    "awslabs.aws-api-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "us-east-1",
        "READ_OPERATIONS_ONLY": "true"
      },
      "disabled": true,
      "autoApprove": []
    },
    "sqlmigration-kit": {
      "command": "python3",
      "args": [
        "supporting-files/mcp/kit_mcp_server.py"
      ],
      "env": {
        "MIGRATION_OFFLINE": "0"
      },
      "disabled": true,
      "autoApprove": [
        "toolbox",
        "audit_tail"
      ],
      "_comment": "PLACEHOLDER/preview: read-only and dry-run kit tools over MCP (supporting-files/mcp/README.md). Enable with disabled=false; Windows: command python, args supporting-files\\\\mcp\\\\kit_mcp_server.py"
    }
  }
}
