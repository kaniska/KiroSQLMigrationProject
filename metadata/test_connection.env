# ============================================================
# Test database connection used by supporting-files/run_tests.sh
# NO SECRETS HERE: the RDS target authenticates with a short-lived IAM token
# generated on every run. Any value can be overridden from the environment,
# e.g.  PGDATABASE=other_test bash supporting-files/run_tests.sh
# ============================================================

# Aurora PostgreSQL 17 cluster (IAM database authentication)
RDS_PGHOST=database-1.cluster-ck1imm86sh9q.us-east-1.rds.amazonaws.com
RDS_PGPORT=5432
RDS_PGDATABASE=sql_migration_test
RDS_PGUSER=migration_agent
RDS_AWS_REGION=us-east-1

# Local PostgreSQL 17 (TEST_TARGET=local)
LOCAL_PGHOST=localhost
LOCAL_PGPORT=5432
LOCAL_PGDATABASE=sql_migration_test
