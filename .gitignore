# ============================================================
# SQLMigrationProject — git ignore rules
# Keep in the repository: .kiro/ (steering, skills, agents, hooks, settings), source/, generated/,
# tests/, metadata/ (no secrets there), docs/, supporting-files/, examples/, .gitattributes.
# Patterns below are folder-name independent, so they hold for every skill and platform.
# ============================================================

# ---- runtime evidence and state (per machine; ship it with services.py sync / archive instead)
logs/
# sidecar lock files created by migkit next to audit/state files
*.jsonl.lock

# ---- build and test output
dist/
**/.generated/
*.rendered.sql.tmp
.*.tmp

# ---- secrets and local credentials (never commit; use IAM auth or AWS Secrets Manager)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.pgpass
.netrc
secret.json
secrets.json
*.secret.json
.aws/
# local, per-developer overrides of committed settings
*.local.json
.kiro/settings/*.local.*

# ---- Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ---- Node (document generators use globally installed docx / pptxgenjs)
node_modules/
npm-debug.log*

# ---- Office and document previews
~$*
*.tmp.docx
*.tmp.pptx

# ---- editors and IDEs (Kiro IDE settings under .kiro/ stay tracked)
.vscode/
.idea/
*.swp
*.swo
*~

# ---- operating systems
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
